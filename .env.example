# Required. A fine-grained personal access token with "Public repositories (read-only)"
# access and no other permissions. https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Optional: enables the /narrative endpoint. Any OpenAI-compatible Chat Completions API.
LLM_API_KEY=
# Default: https://api.deepseek.com  (DeepSeek on Deploy: https://api-sf1-cdn.deploy.com/api/v1)
LLM_BASE_URL=
# Default: deepseek-flash
LLM_MODEL=
# json_object (default; works almost everywhere) or json_schema (constrained decoding,
# where the provider supports it)
LLM_JSON_MODE=

# Optional: restrict which repositories this instance will query, comma-separated.
ALLOWED_REPOS=

# Optional tuning (defaults shown)
# SYNC_TTL_SECONDS=600
# DEFAULT_WINDOW_DAYS=30
# MAX_WINDOW_DAYS=180
# MAX_LOOKBACK_DAYS=365
# LOG_LEVEL=INFO
